[Unit]
Description=Expire IAM audit events, sign-in history and idle rate limits
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=1h
DynamicUser=yes
EnvironmentFile=/etc/iam/retention.env
LoadCredential=pgpass:/etc/iam/retention.pgpass
Environment=PGPASSFILE=%d/pgpass
StateDirectory=iam-retention
ExecStart=/bin/sh /usr/local/libexec/iam/sh.purge-expired-audit-events.sh
ExecStartPost=/usr/bin/touch /var/lib/iam-retention/last-success
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
