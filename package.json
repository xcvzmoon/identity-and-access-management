{
  "name": "identity-and-access-management",
  "description": "Identity and Access Management",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vpx scripts/build.ts",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "vpx scripts/typecheck.ts",
    "refresh": "vpx scripts/refresh.ts",
    "release": "genbumppush",
    "prepare": "vp config --no-agent",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:verbose": "vp test --reporter=verbose",
    "apps:api": "vp -C apps/api run",
    "apps:web": "vp -C apps/web run",
    "packages:database": "vp -C packages/database run",
    "packages:shared": "vp -C packages/shared run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "consola": "catalog:",
    "genbumppush": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
