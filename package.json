{
  "name": "identity-and-access-management",
  "description": "Identity and Access Management",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vpx scripts/ts.build.ts",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "vpx scripts/ts.typecheck.ts",
    "refresh": "vpx scripts/ts.refresh.ts",
    "create-env": "vpx scripts/ts.create-env.ts",
    "release": "genbumppush",
    "prepare": "vp config --no-agent",
    "test": "vp test",
    "test:release": "vpx scripts/tests/ts.run-release.ts",
    "test:watch": "vp test --watch",
    "test:verbose": "vp test --reporter=verbose",
    "docker": "vpx scripts/ts.docker.ts",
    "docker:portless": "sh scripts/sh.portless-compose.sh"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "catalog:",
    "consola": "catalog:",
    "evlog": "catalog:api",
    "genbumppush": "catalog:",
    "nitro": "catalog:api",
    "portless": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.13.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
