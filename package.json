{
  "name": "identity-and-access-management",
  "description": "Identity and Access Management",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vp run --recursive build",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "tsc",
    "release": "genbumppush",
    "prepare": "vp config --no-agent",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:verbose": "vp test --reporter=verbose"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "genbumppush": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
